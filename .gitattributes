# Pi Dentist — Git line ending normalization
# Enforce LF in repo, auto-convert on checkout (Windows)

* text=auto eol=lf

# Force LF for all source files
*.php text eol=lf
*.css text eol=lf
*.js  text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.txt text eol=lf

# Binary files — no conversion
*.woff2 binary
*.woff  binary
*.ttf   binary
*.eot   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.webp  binary
*.mp4   binary
*.pdf   binary
