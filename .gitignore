# ─────────────────────────────────────────────
# Pi Dentist — .gitignore
# Repo root = child theme directory
# ─────────────────────────────────────────────

# WordPress core (nếu ai đó clone vào full WP)
wp-admin/
wp-includes/
wp-*.php
xmlrpc.php
license.txt
readme.html

# Plugins & Uploads (không thuộc theme repo)
plugins/
uploads/
upgrade/
mu-plugins/

# Cache & Compiled
*.cache
cache/
advanced-cache.php
object-cache.php
wp-content/cache/
wp-content/upgrade/

# Environment & Secrets
.env
.env.*
wp-config.php
wp-config-local.php

# Database
*.sql
*.sql.gz
*.sqlite

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
._*

# IDE & Editors
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Keep .vscode/extensions.json, ignore the rest
.vscode/*
!.vscode/extensions.json

# Node / Build tools (nếu dùng build sau này)
node_modules/
package-lock.json
yarn.lock
dist/
.parcel-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
debug.log
error_log

# Test files (dev only)
assets/css-test.html

# Misc
*.bak
*.orig
*.tmp
.sass-cache/
